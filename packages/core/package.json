{
  "name": "@intl-ui/core",
  "version": "1.0.2",
  "description": "Framework-agnostic international data and utilities: countries, phone formatting, validation, dial codes",
  "license": "MIT",
  "author": "John Alberto López Hernández",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./phone": {
      "import": {
        "types": "./dist/phone.d.ts",
        "default": "./dist/phone.js"
      },
      "require": {
        "types": "./dist/phone.d.cts",
        "default": "./dist/phone.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@intl-ui/eslint-config": "workspace:*",
    "@intl-ui/tsconfig": "workspace:*",
    "@intl-ui/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.18.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "phone",
    "international",
    "country",
    "dial-code",
    "format",
    "validate",
    "e164",
    "iso-3166",
    "typescript"
  ],
  "homepage": "https://johnalbh.github.io/intl-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnalbh/intl-ui",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
