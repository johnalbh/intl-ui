{
  "name": "@intl-ui/playground-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Angular playground for manually exercising @intl-ui/angular components.",
  "scripts": {
    "dev": "ng serve --open",
    "build": "ng build",
    "build:ghpages": "ng build --base-href /intl-ui/angular/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .angular"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@intl-ui/angular": "workspace:*",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@intl-ui/tsconfig": "workspace:*",
    "typescript": "^5.8.3"
  }
}
